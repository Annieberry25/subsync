# Supabase API Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Logo.dev API Credentials
NEXT_PUBLIC_LOGO_DEV_TOKEN=your-logo-dev-token-here

# Optional: custom site/canonical domain (defaults to https://subhalt.com)
NEXT_PUBLIC_SITE_URL=https://subhalt.com

# Groq AI Assistant (free tier, no credit card at console.groq.com/keys)
# Required for live AI answers; without it the assistant runs in offline mode.
# Default model: openai/gpt-oss-120b. Use groq/compound (or compound-mini) for
# built-in web search on news/outage questions.
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_WEB_SEARCH=true