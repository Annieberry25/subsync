# Supabase API Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# Server-only. Required for privileged operations that bypass RLS (never exposed to the client).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Logo.dev API Credentials
NEXT_PUBLIC_LOGO_DEV_TOKEN=your-logo-dev-token-here

# Optional: custom site/canonical domain. Used for metadata, sitemap, robots
# and Paystack redirects, and as the HTTPS fallback when deciding whether the
# auth cookie gets the `secure` flag on the server. It is deliberately NOT used
# for the OAuth redirectTo — that is always the origin the flow started on,
# because the PKCE code verifier is a cookie on that host.
#
# It must match the Supabase project's Site URL, or GoTrue will silently discard
# the redirect and send people to the wrong host. Set it in Vercel too: all
# NEXT_PUBLIC_* values are inlined at build time, so changing it requires a
# redeploy, not just a restart.
NEXT_PUBLIC_SITE_URL=https://subhalt.xyz
#
# Supabase dashboard -> Authentication -> URL Configuration must be kept in
# step with the value above:
#   Site URL:      https://subhalt.xyz
#   Redirect URLs: https://subhalt.xyz/auth/callback
#                  https://www.subhalt.xyz/auth/callback
#                  http://localhost:3000/auth/callback
# `/auth/callback` is the path `getAuthCallbackUrl()` builds. Anything missing
# from that list makes Google sign-in fail with no visible error: GoTrue drops
# the redirect and falls back to the Site URL instead.

# Groq AI Assistant (free tier, no credit card at console.groq.com/keys)
# Required for live AI answers; without it the assistant runs in offline mode.
GROQ_API_KEY=your-groq-api-key-here
# Which model serves the assistant. Live web search only works on GPT-OSS
# models (openai/gpt-oss-20b, openai/gpt-oss-120b, openai/gpt-oss-safeguard-20b).
GROQ_MODEL=openai/gpt-oss-120b
# "false" disables the built-in browser search tool on the models that support it.
GROQ_WEB_SEARCH=true
# Vision model used only to TRANSCRIBE receipt screenshots/photos (the text then
# goes through the deterministic parser). Falls back to
# llama-3.2-90b-vision-preview. Without GROQ_API_KEY, image import returns a
# clear "not configured" message and asks the user to paste text instead.
GROQ_VISION_MODEL=llama-3.2-90b-vision-preview

# Paystack Payments (premium upgrades)
# Server-only. Required for live Plus checkouts; without it the upgrade UI shows
# a clear "not configured" error instead of upgrading. Key must have USD enabled.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxx
# Client-safe publishable/secret public key (exposed to the browser; used for popup/display only)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxx

# Google OAuth 2.0 (Gmail receipt discovery)
# Server-only credentials from https://console.cloud.google.com/apis/credentials
# Required to connect a user's Gmail inbox and scan for subscription receipts.
# See STEPS-GMAIL-INTEGRATION.md for the full Google Cloud setup guide.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Must match an "Authorized redirect URI" on your OAuth client.
# Leave unset for local dev (defaults to http://localhost:3000/api/gmail/oauth/callback).
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/oauth/callback

# Inbound email forwarding (manual receipt forwarding)
# Users get a personal address: receipts+<userId>@INBOUND_EMAIL_DOMAIN.
# Set up an inbound webhook provider (Mailgun Routes or Resend inbound) that
# POSTs multipart/form-data to /api/emails/inbound. See STEPS-GMAIL-INTEGRATION.md.
INBOUND_EMAIL_DOMAIN=yourdomain.com
# Preferred: verify Mailgun webhooks with the domain's HTTP Webhook Signing Key.
MAILGUN_SIGNING_KEY=your-mailgun-signing-key
# Alternative: shared secret required on every webhook (form `secret`,
# header `x-webhook-secret`, or `Authorization: Bearer`).
INBOUND_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Background Gmail monitoring + cron (auto-imports new receipts)
# Required by /api/cron/gmail-rescan (Vercel Cron in vercel.json, any external
# cron, or the self-hosted instrumentation.ts loop).
CRON_SECRET=change-me-to-a-long-random-string
# Self-hosted only: true + NEXT_PUBLIC_SITE_URL enables the 6-hour scan loop.
ENABLE_BACKGROUND_GMAIL_SCAN=false

# ---------------------------------------------------------------------------
# Transactional email (Resend)
# ---------------------------------------------------------------------------
# Server-only. Never expose the key to the browser -- lib/email/send.ts imports
# `server-only` so an accidental client import fails the build instead.
#
# With RESEND_API_KEY unset the pipeline is inert: sends are skipped and logged,
# never thrown, so local dev and preview deploys work without it.
RESEND_API_KEY=re_your_resend_api_key
# Verified sending domain on Resend. The from-address defaults to
# "SubHalt <no-reply@subhalt.xyz>" when this is unset.
EMAIL_FROM=SubHalt <no-reply@subhalt.xyz>
EMAIL_FROM_DOMAIN=subhalt.xyz
#
# Shared secret for the Supabase database webhook (POST /api/webhooks/supabase).
# Supabase cannot sign its own webhook, so it sends this in `x-webhook-secret`.
# The endpoint fails CLOSED when this is unset: without it, anyone who guessed
# the path could send mail to arbitrary addresses.
#
# Create the webhooks under Database -> Webhooks:
#   auth.users      INSERT
#   subscriptions   INSERT
# pointing at https://<your-domain>/api/webhooks/supabase
SUPABASE_WEBHOOK_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Web Push (VAPID)
# ---------------------------------------------------------------------------
# Carries the notifications that used to be email: the 10-day renewal notice, the
# weekly recap and the new-insight nudge. Push is what keeps the Resend allowance
# for mail a user actually asked for.
#
# Generate a pair with:
#   npx web-push generate-vapid-keys
# Set the same values in Vercel. The public key is safe to expose -- the browser
# needs it -- and is served from /api/push/vapid-public-key. The PRIVATE key must
# stay server-side; it is never sent to the browser.
#
# With these unset, every push is skipped and logged rather than thrown, so the
# app works without them.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address the push service uses to reach you about delivery failures.
# Browsers reject a subscription whose sender has no mailto:/https: subject.
VAPID_SUBJECT=mailto:hello@mail.subhalt.xyz

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
# All NEXT_PUBLIC_* values are inlined at build time, so changing them
# requires a redeploy, not just a restart.
#
# Bills & Payments is still in active development and is off by default.
# While false it hides the nav entries and redirects /bills, /bills/pay and
# /bills/history to "/", so half of the mobile More sheet is also hidden.
# Read by lib/config/feature-flags.ts.
NEXT_PUBLIC_BILL_PAYMENT_ENABLED=false

# Google AdSense. Ads render only on the free plan and only when BOTH values
# below are set, so leaving them empty shows no placeholder or simulated ad.
# Read by lib/config/adsense.ts.
# Publisher ID, e.g. "ca-pub-1234567890123456"
NEXT_PUBLIC_ADSENSE_CLIENT=
# An existing responsive ad unit slot on that AdSense account
NEXT_PUBLIC_ADSENSE_AD_SLOT=